# Restaurant Availability Checker Configuration
# Copy this to .env and fill in your values

# ============================================
# BOOKING PARAMETERS
# ============================================
TARGET_DATE=2025-12-31
TARGET_TIME=20:00
PARTY_SIZE=4

# Check interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# ============================================
# NOTIFICATION TYPE
# ============================================
# Options: console, email, slack, telegram, pushover, twilio_sms
NOTIFICATION_TYPE=console

# ============================================
# EMAIL SETTINGS (if NOTIFICATION_TYPE=email)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_TO=recipient@example.com
# EMAIL_FROM=your-email@gmail.com

# ============================================
# SLACK SETTINGS (if NOTIFICATION_TYPE=slack)
# ============================================
# Create a webhook at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ============================================
# TELEGRAM SETTINGS (if NOTIFICATION_TYPE=telegram)
# ============================================
# Create a bot via @BotFather, get chat_id by messaging the bot
# and visiting: https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# ============================================
# PUSHOVER SETTINGS (if NOTIFICATION_TYPE=pushover)
# ============================================
# Sign up at: https://pushover.net/
# Get API token by creating an application
# PUSHOVER_USER_KEY=your-user-key
# PUSHOVER_API_TOKEN=your-api-token

# ============================================
# TWILIO SMS SETTINGS (if NOTIFICATION_TYPE=twilio_sms)
# ============================================
# Sign up at: https://www.twilio.com/
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1234567890
# TWILIO_TO_NUMBER=+0987654321

# ============================================
# BROWSER SETTINGS
# ============================================
HEADLESS=true
BROWSER_TIMEOUT=30

# ============================================
# GCP SETTINGS (for cloud deployment)
# ============================================
# GCP_PROJECT_ID=your-project-id
# USE_GCP_SECRETS=false
